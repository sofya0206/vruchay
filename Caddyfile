# DOMAIN задаётся переменной окружения контейнера caddy (например vruchay.ru).
# S3_ORIGIN — адрес объектного хранилища: оттуда грузятся фоны сертификатов,
# и без него они не отобразятся ни в редакторе, ни на странице печати.
# Для локальной проверки прод-сборки: DOMAIN=localhost:8080 — Caddy отдаст http.

# Адрес с www ведёт на основной. Блок обязателен, пока в DNS есть запись www:
# без него Caddy получает запрос на имя, которого не знает, не может подобрать
# сертификат и обрывает рукопожатие — посетитель видит не «страница не найдена»,
# а ошибку защищённого соединения. Пустая запись в DNS была бы честнее, но
# люди набирают www по привычке, поэтому лучше перенаправить.
#
# WWW_DOMAIN задаётся отдельной переменной, а не «www.{$DOMAIN}»: при локальной
# проверке DOMAIN равен localhost:8080, и www для него не выпустить.
{$WWW_DOMAIN:www.invalid} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy api:3000
	}
	handle /health {
		reverse_proxy api:3000
	}
	handle {
		root * /srv/www
		# Сначала предварительно отрисованный файл, и только потом заглушка:
		# роботу должна доставаться готовая разметка, а не пустой div.
		try_files {path} {path}/index.html /index.html
		file_server
	}

	# Шрифты и собранные файлы кэшируются навсегда. Это безопасно ровно потому,
	# что в их именах стоит хеш содержимого: изменившийся файл получает новое
	# имя, и старое имя действительно неизменно. HTML сюда не попадает — он
	# всегда перепроверяется, иначе новая версия не доехала бы до тех,
	# у кого страница уже лежит в кэше.
	@immutable path /fonts/* /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		# Политика содержимого — последний рубеж, если куда-то всё же просочится
		# чужая разметка. Задаётся здесь, а не в приложении: она действует
		# на HTML-документ, а его отдаёт Caddy.
		#
		# style-src разрешает inline: макет сертификата целиком построен
		# на атрибутах style у блоков, иначе редактор и печать сломаются.
		# script-src inline не разрешает — скрипты только из собранных файлов.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$S3_ORIGIN}; font-src 'self' data:; connect-src 'self' {$S3_ORIGIN}; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

		# Страницу нельзя встроить во фрейм: защита от подмены интерфейса поверх нашего.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Возможности браузера, которые сервису не нужны, отключаем явно.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# Внутренний вход для воркера печати.
#
# Воркер открывает страницу листа в браузере, и делать это через внешний адрес
# нельзя: контейнер обращался бы к публичному IP собственного сервера, а такой
# разворот трафика поддерживают не все провайдеры. Порт наружу не публикуется
# (см. docker-compose.prod.yml), поэтому доступ к этому входу есть только
# у соседних контейнеров.
:8080 {
	handle /api/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
