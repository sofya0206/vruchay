{
  "name": "@gramota/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.cjs.json --watch"
  },
  "dependencies": {
    "petrovich": "^0.2.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "vitest": "^3.2.0"
  }
}
