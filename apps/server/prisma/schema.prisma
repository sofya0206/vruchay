// Схема данных. Мультитенантность: почти всё принадлежит организации (orgId).
// Фаза 0: ядро auth. Остальные модели добавляются по фазам плана.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Бесплатная проба против оплаченного доступа. Считаем на организации,
/// а не на пользователе: лимит принадлежит команде, иначе его обходили бы,
/// приглашая в организацию новых коллег.
enum OrgPlan {
  free
  paid
}

/**
 * Как показывать получателя на публичной странице проверки.
 *
 * Настройка эмитента, а не материала: страница открыта без входа, и
 * решение «сколько персональных данных отдавать любому, кто знает код»
 * принимает организация как оператор ПД один раз на всё выданное.
 * `full` — как отмечено в материале; `initials` — фамилия и инициалы;
 * `none` — только факт: «документ подлинный, выдан <организация>».
 */
enum VerifyNameMode {
  full
  initials
  none
}

/// Чем отмеряется срок плана.
///
/// Разовый пакет и год различаются не длиной, а тем, чем кончаются:
/// год — датой, пакет — документами.
enum PlanPeriod {
  package
  year
}

/// Условия конкретной организации: сколько документов, на какой срок
/// и что входит.
///
/// Отдельная запись, а не колонка у организации и тем более не `if` в коде:
/// цена и объём обсуждаются с каждым клиентом отдельно, и менять их
/// правкой кода означало бы релиз на каждый разговор. Прошлые планы
/// не удаляются — по ним видно, что и когда было обещано.
model Plan {
  id    String       @id @default(uuid()) @db.Uuid
  orgId String       @map("org_id") @db.Uuid
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Как план называют в разговоре: «500 документов на год».
  name          String
  /// Сколько документов можно выпустить за период.
  documentLimit Int        @map("document_limit")
  period        PlanPeriod
  startsAt      DateTime   @map("starts_at")
  /// Пусто — срок не ограничен.
  endsAt        DateTime?  @map("ends_at")

  /// Что входит. Значения — из PLAN_FEATURES в packages/shared: список
  /// один на сервер и кабинет, иначе кнопка была бы на экране
  /// и запрещена сервером.
  features String[]

  /// Пакет не сгорает: остаток документов доступен и после даты окончания.
  /// Для годового доступа обычно нет, для оплаченного пакета — да.
  neverExpires Boolean @default(false) @map("never_expires")

  /// Чем закончились переговоры. Наша заметка, клиенту не показывается,
  /// персональных данных здесь быть не должно.
  note String?

  /// Кто назначил — адрес сотрудника платформы, для разбора «откуда это взялось».
  assignedBy String?  @map("assigned_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orgId, startsAt])
  @@map("plans")
}

model Organization {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  plan      OrgPlan     @default(free)
  createdAt DateTime    @default(now()) @map("created_at")

  // ─── Публичное лицо эмитента ─────────────────────────────────────────
  //
  // Страница организации снаружи (/org/<slug>) и то, что о ней говорит
  // страница проверки документа. Всё выключено по умолчанию: организация
  // сама решает, показываться ли ей наружу, и включает это явно.

  /// Адрес публичной страницы: /org/<slug>. Пусто — страницы нет.
  slug        String? @unique
  description String  @default("")
  inn         String  @default("")
  website     String  @default("")
  /// Куда писать проверяющему: «сообщить о проблеме» на странице проверки.
  contactEmail String @default("") @map("contact_email")
  contactPhone String @default("") @map("contact_phone")
  logoFileId   String? @map("logo_file_id") @db.Uuid
  logo         File?   @relation("OrgLogo", fields: [logoFileId], references: [id], onDelete: SetNull)

  /**
   * Значок «Верифицированный эмитент».
   *
   * Проставляется владельцем сервиса руками после проверки домена и ИНН
   * (см. PlatformController), а не самой организацией: значок — наше
   * ручательство, и выдавать его себе никто не должен. Автоматическая
   * проверка по DNS и ЕГРЮЛ — отдельная задача.
   */
  verifiedIssuer Boolean   @default(false) @map("verified_issuer")
  verifiedAt     DateTime? @map("verified_at")

  /// Показывать ли публичную страницу организации вообще.
  publicPageEnabled Boolean @default(false) @map("public_page_enabled")
  /**
   * Поиск по ФИО в публичном реестре.
   *
   * Выключен по умолчанию и включается только явно: поиск по фамилии
   * без согласия субъекта — распространение персональных данных
   * (ст. 10.1 152-ФЗ, «ПД, разрешённые для распространения»). Согласие
   * собирает эмитент как оператор; мы даём инструмент и галочку.
   */
  publicSearchByName Boolean @default(false) @map("public_search_by_name")
  /**
   * Пускать ли поисковики на страницу организации и страницы проверки
   * её документов. Выключено — везде стоит noindex.
   */
  publicIndexable Boolean @default(false) @map("public_indexable")
  verifyNameMode  VerifyNameMode @default(full) @map("verify_name_mode")

  /// Код приглашения. Заводится при первом открытии раздела «Пригласить
  /// друга», а не при регистрации: у большинства организаций его никогда
  /// не спросят, а раздавать коды всем — значит занимать словарь коротких
  /// сочетаний ради тех, кто им не воспользуется.
  referralCode    String?  @unique @map("referral_code")
  /// Кто пригласил. Начисленные бонусы нигде не хранятся: они выводятся из
  /// этой связи и из числа выпущенных приглашёнными документов (см.
  /// ReferralService). Отдельный счётчик пришлось бы держать в согласии
  /// с реальностью при каждом удалении и ошибке, а связь ничему
  /// противоречить не может.
  referredByOrgId String?  @map("referred_by_org_id") @db.Uuid
  referredBy      Organization?  @relation("OrgReferrals", fields: [referredByOrgId], references: [id], onDelete: SetNull)
  referrals       Organization[] @relation("OrgReferrals")

  /**
   * Свой домен для страницы проверки: ссылки и QR ведут на него, а не
   * на vruchay.ru. Пусто — общий домен сервиса. Маршрутизация по чужому
   * домену — отдельная задача; здесь только само поле и его проверка.
   */
  verifyDomain String @default("") @map("verify_domain")

  /**
   * Сколько дней материал лежит в корзине, прежде чем исчезнуть вместе
   * с выданными файлами. Хранить дольше, чем требует цель, запрещает
   * ч. 7 ст. 5 152-ФЗ, а решает срок сама организация — она оператор
   * этих данных. Семь дней по умолчанию: столько было общей константой
   * до появления настройки.
   */
  trashDays Int @default(7) @map("trash_days")

  // ─── Реквизиты для счетов и закрывающих ───────────────────────────────
  //
  // Кто платит: юрлицо, ИП, самозанятый или физлицо. Пустой вид — реквизиты
  // ещё не заполнены; тогда кабинет подставляет их из последнего счёта
  // (Invoice хранит копию реквизитов покупателя).
  billingKind    BillingKind? @map("billing_kind")
  billingName    String @default("") @map("billing_name")
  billingInn     String @default("") @map("billing_inn")
  billingKpp     String @default("") @map("billing_kpp")
  billingOgrn    String @default("") @map("billing_ogrn")
  billingAddress String @default("") @map("billing_address")
  billingEmail   String @default("") @map("billing_email")

  members     OrgMember[]
  documents   Document[]
  files       File[]
  jobs        GenerationJob[]
  mailDomains MailDomain[]
  senders     Sender[]
  templates   EmailTemplate[]
  emails      Email[]
  integrations TildaIntegration[]
  tildaRequests TildaRequest[]
  consents    Consent[]
  reviews     Review[]
  auditEvents AuditEvent[]
  apiTokens   ApiToken[]
  awardRuleSets AwardRuleSet[]
  supportTickets SupportTicket[]
  roadmapVotes   RoadmapVote[]
  plans         Plan[]

  @@map("organizations")
}

enum BillingKind {
  legal
  ie
  self_employed
  individual
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String      @map("password_hash")
  name         String      @default("")
  /// Пока не заполнено — адрес не подтверждён и войти нельзя. Учётные записи,
  /// заведённые оператором из консоли, помечаются подтверждёнными сразу:
  /// адрес там вводит сам оператор, проверять нечего.
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  // ─── Второй фактор входа ─────────────────────────────────────────────
  //
  // Секрет TOTP лежит зашифрованным (AES-256-GCM, ключ из TOTP_SECRET_KEY,
  // см. auth/totp-crypto.ts): утечка базы не должна отдавать чужие коды.
  // Заполнен вместе с totpEnabledAt — до подтверждения первым кодом
  // секрет живёт только в Redis и в базу не попадает.
  totpSecret    String?   @map("totp_secret")
  totpEnabledAt DateTime? @map("totp_enabled_at")

  /// Тема кабинета и формат дат — настройки человека, а не организации:
  /// один и тот же сотрудник состоит в нескольких организациях.
  theme      UiTheme    @default(system)
  dateFormat DateFormat @default(numeric) @map("date_format")
  density    UiDensity  @default(comfortable)

  memberships  OrgMember[]
  reviews      Review[]
  backupCodes  TotpBackupCode[]
  sessions     UserSession[]
  loginEvents  LoginEvent[]
  supportTickets   SupportTicket[]
  supportMessages  SupportMessage[]

  @@map("users")
}

enum UiTheme {
  system
  light
  dark
}

/// Как показывать даты в кабинете: 03.09.2026, 3 сентября 2026, 2026-09-03.
enum DateFormat {
  numeric
  long
  iso
}

/**
 * Плотность интерфейса. `compact` поджимает вертикальные отступы в списках
 * и таблицах: у федерации в реестре тысячи строк, и лишние восемь пикселей
 * на строке — это экран, который приходится прокручивать.
 *
 * Языка рядом нет намеренно: переключатель языка без перевода интерфейса
 * обещал бы то, чего сервис не умеет.
 */
enum UiDensity {
  comfortable
  compact
}

/**
 * Резервные коды второго фактора.
 *
 * Хранятся HMAC-SHA256 от кода с серверным ключом, а не argon2: кодов
 * десять, и при входе сверять пришлось бы каждый — десять argon2 подряд
 * на каждый вход это секунды. У кода 50 бит энтропии, а ключ HMAC —
 * серверный секрет, так что без него база ничего не выдаёт.
 */
model TotpBackupCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  codeHash String    @unique @map("code_hash")
  usedAt   DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("totp_backup_codes")
}

/**
 * Активные сессии.
 *
 * Cookie сессии шифрованная и сама по себе не отзывается: раньше выйти
 * «на всех устройствах» было нельзя вовсе. Теперь cookie несёт случайный
 * идентификатор, а его хеш проверяется здесь на каждом запросе — так
 * сессию можно завершить с другого устройства. Хеш, а не сам
 * идентификатор: по строке из базы cookie собрать нельзя.
 */
model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  ip        String?   @db.Inet
  userAgent String    @default("") @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

enum LoginOutcome {
  success
  wrong_password
  wrong_code
  not_verified
}

/**
 * Журнал авторизаций: удачные и неудачные входы.
 *
 * Пишется только для существующих учётных записей — попытка входа
 * на несуществующий адрес никому не принадлежит, и хранить чужие адреса
 * ради неё нельзя. Показывается человеку только его собственный.
 */
model LoginEvent {
  id        BigInt       @id @default(autoincrement())
  userId    String       @map("user_id") @db.Uuid
  outcome   LoginOutcome
  ip        String?      @db.Inet
  userAgent String       @default("") @map("user_agent")
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("login_events")
}

enum OrgRole {
  owner
  admin
  member
}

model OrgMember {
  orgId  String  @map("org_id") @db.Uuid
  userId String  @map("user_id") @db.Uuid
  role   OrgRole @default(member)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@map("org_members")
}

// ─── Документы (Фаза 1) ───────────────────────────────────────────────────

model Document {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  title          String
  /** размер листа в миллиметрах: A4 альбомный = 297×210 */
  pageWidthMm    Float    @default(297) @map("page_width_mm")
  pageHeightMm   Float    @default(210) @map("page_height_mm")
  /** показывать ли страницу проверки подлинности и какие поля на ней раскрывать */
  verifyEnabled  Boolean  @default(true) @map("verify_enabled")
  verifyFields   Json     @default("[]") @map("verify_fields")

  /*
   * Мероприятие, за которое выдаются документы.
   *
   * Хранится у документа, а не в макете, потому что меняется чаще макета:
   * бланк федерации один на сезон, а соревнований за сезон десятки. Пока
   * этих полей не было, название и дата вписывались прямо в текст на листе,
   * и на каждое соревнование приходилось делать копию шаблона.
   *
   * Дата строкой, а не датой: на грамотах пишут и «17 июня 2026 года»,
   * и «17–19 июня 2026», и «сезон 2025/26». Календарное поле заставило бы
   * выбирать одно из них и упростило бы задачу до неверной.
   */
  eventName   String @default("") @map("event_name")
  eventDate   String @default("") @map("event_date")
  eventPlace  String @default("") @map("event_place")
  eventHours  String @default("") @map("event_hours")
  /**
   * Дата выдачи, если она не совпадает с днём выпуска: грамоты за прошедшее
   * мероприятие печатают позже, а на них должна стоять дата награждения.
   * null — дата выпуска, как и раньше.
   */
  issueDate   DateTime? @map("issue_date") @db.Date

  /**
   * Срок действия выпускаемых документов — правило, а не факт.
   *
   * Два способа, и нужны оба (см. verify/expiry.ts): длительность от
   * выдачи в записи ISO 8601 (`P1Y` — сертификаты о квалификации, у
   * которых срок свой у каждого) и фиксированная дата (сезонный допуск,
   * один срок на всех). Пусто и там и там — документы бессрочные.
   *
   * Правило применяется в момент выпуска и записывается в файл: менять
   * его потом можно, выданные документы от этого не меняются — их срок
   * напечатан на бумаге.
   */
  expiresIn String?   @map("expires_in")
  expiresAt DateTime? @map("expires_at")

  /**
   * Раздел библиотеки: спортивные соревнования, обучение, благодарности.
   * Не перечисление, а строка: набор разделов живёт в `@gramota/shared`
   * и правится вместе с заготовками, а миграция ради нового раздела —
   * цена, которой этот выбор не стоит. Значение проверяет Zod на входе.
   * null — материал заведён до появления разделов или без выбора.
   */
  category String? @map("category")

  /**
   * Материал, с которого сняли копию под новое мероприятие.
   *
   * Ссылка на себя, а не отдельная модель шаблона: полное разделение
   * «бланк отдельно, мероприятие отдельно» задело бы ядро выпуска,
   * и делается отдельной задачей. Пока это видимая связь «сделан
   * на основе того», по которой человек находит исходный бланк.
   *
   * SetNull, а не Cascade: исходник могли удалить насовсем, и копии
   * от этого пропадать не должны — они самостоятельные материалы.
   */
  sourceDocumentId String?    @map("source_document_id") @db.Uuid
  sourceDocument   Document?  @relation("DocumentCopies", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  copies           Document[] @relation("DocumentCopies")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  /**
   * Набор правил награждения, по которому раскладывается протокол.
   * Многие документы на один набор: федерация настраивает награждение
   * один раз на сезон. Удаление набора документы не трогает — они
   * остаются, просто без раскладки.
   */
  ruleSetId String?       @map("rule_set_id") @db.Uuid
  ruleSet   AwardRuleSet? @relation("DocumentRuleSet", fields: [ruleSetId], references: [id], onDelete: SetNull)

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sheets  Sheet[]
  files   File[]
  columns   RecipientColumn[]
  rows      RecipientRow[]
  jobs      GenerationJob[]
  templates EmailTemplate[]
  emails    Email[]
  tildaRequests TildaRequest[]

  @@index([orgId, deletedAt])
  // Библиотека фильтруется по разделу внутри организации — это её главный запрос.
  @@index([orgId, category])
  @@map("documents")
}

model Sheet {
  id               String  @id @default(uuid()) @db.Uuid
  documentId       String  @map("document_id") @db.Uuid
  position         Int
  backgroundFileId String? @map("background_file_id") @db.Uuid
  /**
   * Массив элементов листа. Валидируется Zod-схемой sheetLayout из @gramota/shared —
   * это общий контракт редактора, превью и серверного PDF-рендера.
   * Отдельной таблицы элементов нет: по ним не нужны SQL-запросы, а редактор
   * сохраняет макет целиком одним PATCH.
   */
  layout           Json    @default("[]")
  schemaVersion    Int     @default(1) @map("schema_version")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  background File?    @relation("SheetBackground", fields: [backgroundFileId], references: [id], onDelete: SetNull)

  @@unique([documentId, position])
  @@map("sheets")
}

enum FileKind {
  background
  asset
  generated
  font
}

model File {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  documentId   String?  @map("document_id") @db.Uuid
  kind         FileKind
  s3Key        String   @map("s3_key")
  sizeBytes    Int      @map("size_bytes")
  mime         String
  originalName String   @default("") @map("original_name")
  /**
   * Публичный идентификатор для проверки подлинности: попадает в QR-код
   * и в ссылку /verify/<publicId>. Генерируется у всех файлов сразу,
   * даже до включения модуля верификации, — иначе выданные раньше
   * сертификаты нельзя будет проверить задним числом.
   */
  publicId      String   @unique @default(uuid()) @map("public_id") @db.Uuid
  /**
   * Короткий публичный код: `K7M2-9QXR-4TVB`, алфавит Крокфорда, хвост
   * HMAC (см. verify/public-code.ts). Печатается на бумаге, кодируется
   * в QR, диктуется по телефону — UUID для всего этого слишком длинный.
   *
   * Считается в приложении, а не базой: базе неоткуда взять секрет
   * для хвоста. Null у документов, выпущенных до появления кода: их QR
   * уже напечатан со ссылкой на publicId, и она продолжает работать.
   * Задним числом код им не назначается — на их бумаге его всё равно нет.
   */
  publicCode    String?  @unique @map("public_code")
  /**
   * Регистрационный номер «по-бухгалтерски»: «142/2026», сквозной
   * у организации за год. Выделяется при выпуске экземпляра, до печати,
   * из счётчика IssueCounter — и печатается на документе полем reg_number.
   *
   * Не то же самое, что публичный код: номер ведёт организация для своей
   * отчётности, код — для проверки посторонним. Первый может повторяться
   * между организациями, второй уникален на весь сервис.
   */
  regNumber     String?  @map("reg_number")
  verifyRevoked Boolean  @default(false) @map("verify_revoked")
  createdAt     DateTime @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  /**
   * Когда документ перестаёт действовать. Null — бессрочный.
   *
   * Факт, а не правило: посчитан при выпуске из настроек материала
   * (Document.expiresIn / expiresAt) и больше не меняется. Состояние
   * «истёк» отдельно не хранится — оно выводится из этой даты и часов,
   * как и остальные состояния (см. registry/file-state.ts).
   */
  expiresAt DateTime? @map("expires_at")
  /**
   * Когда участнику ушло письмо о скором истечении срока. Ночная задача
   * шлёт его один раз — по этой отметке, а не по журналу писем.
   */
  expiryNoticeAt DateTime? @map("expiry_notice_at")

  /**
   * SHA-256 выпущенного файла — тех самых байтов, что ушли участнику.
   *
   * По нему человек сверяет файл на руках со страницей проверки прямо
   * в браузере, не отправляя файл никуда. Null у документов, выпущенных
   * до появления отпечатка: пересчитать его потом можно только скачав
   * файл заново, и это отдельная разовая работа.
   */
  pdfSha256 String? @map("pdf_sha256")

  /**
   * Снимок данных получателя на момент выпуска — то, что напечатано.
   *
   * Страница проверки читает его, а не живую строку таблицы: строку
   * потом правят (опечатка в фамилии перед перевыпуском), и страница
   * не должна показывать имя, которого нет на бумаге. Правка названия
   * мероприятия, наоборот, применяется ко всем выданным — она берётся
   * из материала, а не отсюда. Null у документов, выпущенных раньше.
   */
  issuedData Json? @map("issued_data")

  /**
   * Отзыв: когда и почему. Две причины, и это не дубль: публичную видит
   * человек с бумагой на странице проверки («выдан по ошибке»), внутреннюю —
   * только сотрудники организации в реестре («перепутали протоколы,
   * см. письмо судьи»). Обе остаются и после возврата проверки: журнал
   * причин — часть истории документа.
   */
  revokedAt             DateTime? @map("revoked_at")
  revokedReasonPublic   String?   @map("revoked_reason_public")
  revokedReasonInternal String?   @map("revoked_reason_internal")

  /**
   * Порядковый номер для списка состояний (Bitstring Status List).
   *
   * Задел: сам список — офлайн-проверка отзыва по подписанному QR —
   * делается позже, но номер должен быть у документа с момента выпуска,
   * иначе выданному раньше его будет неоткуда взять. Растёт монотонно
   * и никогда не переиспользуется — как и сам код документа.
   */
  statusIndex BigInt @unique @default(autoincrement()) @map("status_index")

  /// Когда PDF подписан электронной подписью сервиса (PAdES). Null — не подписан.
  signedAt DateTime? @map("signed_at")

  jobId String? @map("job_id") @db.Uuid
  /**
   * Строка получателя, ради которой файл выпущен.
   *
   * Вместе с jobId образует ключ идемпотентности: пара (job_id, row_id)
   * уникальна, поэтому повторная обработка строки не создаст второй файл
   * даже если воркер запустится дважды. Это не удобство, а деньги: квота
   * считается по числу файлов, и дубликат списал бы документ повторно.
   *
   * При удалении строки обнуляется, а файл остаётся: выпущенный документ
   * мог уже уйти участнику и быть проверен по QR-коду.
   */
  rowId String? @map("row_id") @db.Uuid

  /**
   * Перевыпуск: задание, которое должно заменить этот файл.
   *
   * Ставится в момент, когда человек нажал «Перевыпустить», — то есть до
   * того, как новый документ существует. Пока файла-замены нет, старый
   * остаётся действительным: выпуск может упасть или быть отменён, и
   * гасить настоящий сертификат под обещание нового нельзя.
   *
   * Замену находим по паре (job_id, row_id) — тому же ключу идемпотентности,
   * которым пользуется очередь. Найденную запоминаем в replacedById, чтобы
   * связь пережила удаление строки из таблицы получателей.
   */
  replacedByJobId String? @map("replaced_by_job_id") @db.Uuid
  replacedById    String? @map("replaced_by_id") @db.Uuid

  /**
   * Сколько раз документ проверяли по QR-коду и когда в последний раз.
   *
   * Обезличенный счётчик: ни адреса, ни устройства, ни отпечатка браузера
   * проверяющего мы не храним. Организации нужен ответ «сертификат проверили
   * 47 раз», а не досье на того, кто проверял, — и по 152-ФЗ второе
   * перевело бы нас из обработчика по поручению в самостоятельного оператора.
   */
  verifyCount  Int       @default(0) @map("verify_count")
  verifyLastAt DateTime? @map("verify_last_at")

  /** Сколько раз файл скачивали из кабинета — тоже только счётчиком. */
  downloadCount Int @default(0) @map("download_count")

  org             Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  document        Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  job             GenerationJob? @relation("JobFiles", fields: [jobId], references: [id], onDelete: SetNull)
  row             RecipientRow?  @relation("RowGenerated", fields: [rowId], references: [id], onDelete: SetNull)
  replacedBy      File?          @relation("FileReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces        File[]         @relation("FileReplacement")
  sheetBackground Sheet[]        @relation("SheetBackground")
  orgLogos        Organization[] @relation("OrgLogo")
  rows            RecipientRow[] @relation("RowFile")
  emails          Email[]        @relation("EmailFile")
  tildaRequests   TildaRequest[]

  @@unique([jobId, rowId])
  @@index([orgId, kind])
  /// Реестр листает выданное по организации в обратном хронологическом
  /// порядке — без этого индекса каждая страница читала бы все файлы.
  @@index([orgId, kind, createdAt])
  /// Ночная задача ищет документы, срок которых выходит в ближайшие недели.
  @@index([expiresAt])
  @@map("files")
}

// ─── Получатели и генерация (Фаза 2) ──────────────────────────────────────

model RecipientColumn {
  id         String @id @default(uuid()) @db.Uuid
  documentId String @map("document_id") @db.Uuid
  position   Int
  /** Имя переменной без знака процента: name, email, course. */
  name       String
  /**
   * Заголовок этой колонки в загруженном файле: «Год рождения», «Команда».
   *
   * Имя переменной для макета и заголовок для человека — разные вещи.
   * `birth_year` пишут в `%birth_year` на листе, но в шапке таблицы
   * получателей человек ждёт увидеть ту же надпись, что была в его файле.
   * Пока заголовка не было, таблица показывала служебные имена, и колонки
   * приходилось опознавать по значениям.
   *
   * null — колонка заведена руками или до появления заголовков; тогда
   * в шапке остаётся имя переменной, как и раньше.
   */
  title      String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, position])
  @@unique([documentId, name])
  @@map("recipient_columns")
}

model RecipientRow {
  id         String  @id @default(uuid()) @db.Uuid
  documentId String  @map("document_id") @db.Uuid
  position   Int
  /** Значения по именам колонок: {"name":"Иванов Иван","email":"..."} */
  data       Json    @default("{}")
  /** Отмеченные строки попадают в генерацию. */
  checked    Boolean @default(true)
  lastFileId String? @map("last_file_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lastFile File?    @relation("RowFile", fields: [lastFileId], references: [id], onDelete: SetNull)
  /** Все файлы, когда-либо выпущенные по этой строке, — по одному на задание. */
  generated File[]  @relation("RowGenerated")
  emails    Email[]

  @@unique([documentId, position])
  @@index([documentId, checked])
  @@map("recipient_rows")
}

enum JobStatus {
  queued
  running
  done
  failed
  canceled
}

model GenerationJob {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  documentId String    @map("document_id") @db.Uuid
  format     String    @default("pdf")
  status     JobStatus @default(queued)
  total      Int       @default(0)
  done       Int       @default(0)
  failed     Int       @default(0)
  error      String?

  /**
   * На сколько частей пакет разрезан в очереди.
   *
   * Пакет — это не одна задача, а несколько по полсотни строк: иначе
   * запущенный выпуск на десять тысяч держал бы воркер часами, и пакет
   * на пять грамот, поставленный следом, ждал бы его целиком.
   * Число нужно, чтобы снять с очереди все части разом при отмене.
   */
  chunks     Int       @default(0)
  /**
   * Номер попытки. Растёт, когда упавший выпуск продолжают.
   *
   * Входит в идентификаторы частей в очереди: BullMQ молча отказывается
   * добавлять задачу с уже существующим идентификатором, а часть прошлой
   * попытки может ещё лежать в Redis.
   */
  attempt    Int       @default(1)

  createdAt  DateTime  @default(now()) @map("created_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  document Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  files    File[]       @relation("JobFiles")
  rowFailures GenerationRowFailure[]

  @@index([orgId, status])
  @@map("generation_jobs")
}

/**
 * Строка, которую выпустить не удалось.
 *
 * Хранится фактом, а не счётчиком, — по той же причине, по какой квота
 * считается по файлам. Счётчик нельзя сложить из нескольких частей пакета,
 * идущих вразнобой: часть, вернувшаяся из очереди после перезапуска
 * воркера, прибавила бы свои ошибки второй раз.
 *
 * А главное — из этих записей и файлов складывается ответ на вопрос
 * «пакет доработал?». Строка либо стала файлом, либо попала сюда; пока
 * сумма меньше обещанного, какая-то часть ещё в пути, и объявлять выпуск
 * законченным нельзя — иначе участникам уйдёт половина писем.
 *
 * Ссылки на recipient_rows нет намеренно: одна из причин попасть сюда —
 * что строку удалили, пока шёл выпуск.
 */
model GenerationRowFailure {
  jobId     String   @map("job_id") @db.Uuid
  rowId     String   @map("row_id") @db.Uuid
  /** Причина по-русски: её видит владелец в отчёте о выпуске. */
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, rowId])
  @@map("generation_row_failures")
}

// ─── Почта (Фаза 3) ────────────────────────────────────────────────────────

enum MailDomainStatus {
  pending
  verified
  failed
}

model MailDomain {
  id       String           @id @default(uuid()) @db.Uuid
  orgId    String           @map("org_id") @db.Uuid
  domain   String
  provider String           @default("smtp")
  status   MailDomainStatus @default(pending)
  /** DNS-записи, которые владелец домена должен прописать: [{type,host,value}] */
  dnsRecords Json           @default("[]") @map("dns_records")
  /** Идентификатор домена на стороне почтового провайдера, если тот его выдаёт. */
  providerRef String?       @map("provider_ref")
  /**
   * Секрет подтверждения владения доменом. Уникален для каждой заявки:
   * прописать его в DNS может только тот, у кого есть доступ к зоне.
   * Без этого любая организация «подтвердила» бы чужой домен, просто
   * повторив общие для всех записи SPF.
   */
  verificationToken String @default(uuid()) @map("verification_token")

  verifiedAt    DateTime? @map("verified_at")
  lastCheckedAt DateTime? @map("last_checked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  senders Sender[]

  @@unique([orgId, domain])
  @@map("mail_domains")
}

model Sender {
  id          String  @id @default(uuid()) @db.Uuid
  orgId       String  @map("org_id") @db.Uuid
  domainId    String  @map("domain_id") @db.Uuid
  email       String
  displayName String  @map("display_name")
  isDefault   Boolean @default(false) @map("is_default")

  /**
   * Куда участник попадёт, нажав «Ответить». Пусто — на сам адрес
   * отправителя. Нужен, когда письма уходят с noreply, а отвечать
   * человек должен в приёмную комиссию.
   */
  replyTo String @default("") @map("reply_to")
  /**
   * Подпись, которая дописывается к письму о выдаче документа.
   *
   * Только к транзакционному: рекламный низ добавляет отдельный код
   * и только рекламной ветке (см. mailing/letter-kind.ts). Подпись
   * с рекламой внутри письма о выдаче сделала бы рекламным всё письмо.
   */
  signature String @default("")

  createdAt DateTime @default(now()) @map("created_at")

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domain    MailDomain      @relation(fields: [domainId], references: [id], onDelete: Cascade)
  templates EmailTemplate[]

  @@unique([orgId, email])
  @@map("senders")
}

/**
 * Поток отправки. Разделение не про удобство, а про деньги.
 *
 * Выдача документа, ссылка на него и уведомление об истечении срока —
 * переписка по существу отношений, согласия по ст. 18 ФЗ «О рекламе»
 * она не требует. Реклама требует согласия, отписки и журнала согласий.
 *
 * Ловушка в том, что рекламный кусок внутри транзакционного письма делает
 * рекламным всё письмо целиком, а штраф по ст. 14.3 КоАП для юрлица — от
 * 300 тысяч до миллиона рублей за каждый факт. Поэтому поток — это поле
 * в базе и развилка в коде, а не строчка в инструкции для оператора:
 * оператор ошибается один раз, а платит организация за каждое письмо.
 */
enum EmailKind {
  transactional
  marketing
}

model EmailTemplate {
  id         String  @id @default(uuid()) @db.Uuid
  orgId      String  @map("org_id") @db.Uuid
  documentId String? @map("document_id") @db.Uuid
  senderId   String? @map("sender_id") @db.Uuid

  /**
   * Шаблонов у документа столько, сколько потоков: транзакционный и
   * рекламный не пересекаются нигде, включая текст. Транзакционная
   * отправка ищет шаблон с фильтром по этому полю и рекламный
   * не найдёт даже случайно.
   */
  kind EmailKind @default(transactional)
  /**
   * Рекламодатель: ст. 18 требует, чтобы получатель видел, чья это реклама.
   * Заполнен только у рекламных шаблонов — транзакционному письму
   * рекламодателя не полагается по определению.
   */
  advertiserName String? @map("advertiser_name")

  subject  String
  bodyHtml String  @map("body_html")
  /** Прикладывать ли к письму сгенерированный для этой строки файл. */
  attachGeneratedFile Boolean @default(true) @map("attach_generated_file")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  document Document?    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sender   Sender?      @relation(fields: [senderId], references: [id], onDelete: SetNull)
  emails   Email[]

  @@map("email_templates")
}

enum EmailStatus {
  queued
  sent
  delivered
  opened
  bounced
  failed
}

model Email {
  id         String @id @default(uuid()) @db.Uuid
  orgId      String @map("org_id") @db.Uuid
  documentId String? @map("document_id") @db.Uuid
  rowId      String? @map("row_id") @db.Uuid
  templateId String? @map("template_id") @db.Uuid
  fileId     String? @map("file_id") @db.Uuid

  /**
   * Поток копией с шаблона на момент постановки в очередь.
   *
   * Именно копией: шаблон можно потом переделать из рекламного
   * в транзакционный, а по журналу за прошлый год отвечать перед
   * проверкой придётся тем, чем письмо было в день отправки.
   */
  kind EmailKind @default(transactional)

  toEmail  String @map("to_email")
  subject  String
  provider String @default("smtp")
  providerMessageId String? @map("provider_message_id")

  /**
   * Готовый текст письма, если он не из шаблона организации.
   *
   * Служебные письма о самом документе — уведомление о скором истечении
   * срока — пишет сервис, а не организация, и шаблона у них нет. Пусто —
   * тело собирается из шаблона при отправке, как и раньше.
   */
  bodyHtml String? @map("body_html")
  /**
   * Прикладывать ли файл. У письма о выдаче — да, у уведомления о сроке —
   * нет: документ у человека уже есть, второй раз слать его незачем.
   */
  attachFile Boolean @default(true) @map("attach_file")

  status EmailStatus @default(queued)
  error  String?

  queuedAt        DateTime  @default(now()) @map("queued_at")
  sentAt          DateTime? @map("sent_at")
  statusUpdatedAt DateTime  @default(now()) @map("status_updated_at")

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /**
   * Материал, по которому ушло письмо.
   *
   * Cascade, в отличие от файлов: файл мог уже уйти участнику и проверяться
   * по QR-коду, а запись о письме нужна только рядом со своим материалом.
   * Пока связи не было, удаление материала оставляло в базе адреса
   * участников навсегда — вопреки сроку хранения, который остальным
   * таблицам считает ночная задача.
   */
  document Document?      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /**
   * Строка получателя. SetNull, а не Cascade: список получателей переливают
   * заново при каждом повторном импорте, а журнал отправки за прошлое
   * награждение от этого пропадать не должен.
   */
  row      RecipientRow?  @relation(fields: [rowId], references: [id], onDelete: SetNull)
  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  file     File?          @relation("EmailFile", fields: [fileId], references: [id], onDelete: SetNull)
  events   EmailEvent[]
  tildaRequests TildaRequest[]

  @@index([orgId, status])
  @@index([documentId])
  /// Карточка документа в реестре ищет письма ровно так: по выданному файлу.
  @@index([fileId])
  /// Ночная уборка выбирает письма старше срока хранения по всем организациям.
  @@index([queuedAt])
  @@map("emails")
}

model EmailEvent {
  id        BigInt   @id @default(autoincrement())
  emailId   String   @map("email_id") @db.Uuid
  type      String
  source    String
  payload   Json     @default("{}")
  occurredAt DateTime @default(now()) @map("occurred_at")

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@map("email_events")
}

// ─── Публичные формы: Тильда и виджеты (Фаза 4) ────────────────────────────

enum TildaAuthMode {
  none
  email_code
}

model TildaIntegration {
  id    String @id @default(uuid()) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  name  String

  /** Попадает в адрес скрипта на странице клиента, поэтому виден всем. */
  token String @unique @default(uuid()) @db.Uuid

  /** Домены страниц, с которых принимаются заявки. Пустой список = не принимать. */
  allowedDomains String[] @map("allowed_domains")
  /** Какие документы разрешено запрашивать через эту интеграцию. */
  documentIds    String[] @map("document_ids") @db.Uuid

  authMode TildaAuthMode @default(email_code) @map("auth_mode")
  /** Один файл на пару «документ + адрес»: повторный запрос отдаёт готовый. */
  singleFilePerEmail Boolean @default(true) @map("single_file_per_email")
  dailyLimit         Int     @default(500) @map("daily_limit")

  successMessage String  @default("Спасибо! Документ отправлен на вашу почту") @map("success_message")
  showDownload   Boolean @default(true) @map("show_download")
  sendEmail      Boolean @default(true) @map("send_email")
  copyToEmail    String? @map("copy_to_email")
  active         Boolean @default(true)

  /**
   * Подставлять имя и почту из личного кабинета площадки.
   *
   * У Тильды внутри личного кабинета к формам добавляются `ma_name`
   * и `ma_email` — имя и адрес вошедшего участника. Если они есть,
   * человеку остаётся только подтвердить их, а не набирать заново.
   *
   * Данные приходят из браузера, поэтому сами по себе доказательством
   * личности не служат: подтверждение по коду (`authMode`) остаётся
   * отдельной настройкой и решает, доверяем мы подставленному адресу
   * или проверяем его.
   */
  prefillFromAccount Boolean @default(true) @map("prefill_from_account")
  /** Можно ли править подставленные данные. Выключено — только подтвердить. */
  allowEdit          Boolean @default(true) @map("allow_edit")
  /** Кнопки «поделиться» на окне успеха. */
  showShare          Boolean @default(true) @map("show_share")
  /** Ссылка на страницу проверки подлинности в окне успеха. */
  showVerifyLink     Boolean @default(false) @map("show_verify_link")

  /**
   * Выдавать только тем, кто есть в реестре получателей документа.
   *
   * Проверка идёт до подтверждения адреса: посылать код тому, кому документ
   * всё равно не положен, — значит слать письмо в никуда и подсказывать
   * постороннему, что адрес обрабатывается.
   */
  checkList          Boolean @default(false) @map("check_list")
  /**
   * Принимать заявку, только если площадка сообщила адрес учётной записи.
   *
   * Означает «форма стоит внутри личного кабинета, и человек в него вошёл».
   * Сам по себе доказательством не служит — данные приходят из браузера, —
   * но отсекает заявки со страниц, куда форму скопировали.
   */
  requireAccount     Boolean @default(false) @map("require_account")

  createdAt DateTime @default(now()) @map("created_at")

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requests TildaRequest[]

  @@index([orgId])
  @@map("tilda_integrations")
}

enum TildaRequestStatus {
  pending_otp
  processing
  done
  failed
  rejected
}

model TildaRequest {
  id            String @id @default(uuid()) @db.Uuid
  integrationId String @map("integration_id") @db.Uuid
  orgId         String @map("org_id") @db.Uuid
  documentId    String @map("document_id") @db.Uuid

  email  String
  /**
   * Адрес учётной записи на площадке, откуда пришла заявка (`ma_email`
   * у Тильды). Отличается от `email` тем, что человек его не набирал:
   * он подставлен личным кабинетом, в который человек вошёл.
   *
   * Нужен, чтобы «один сертификат в руки» держалось даже когда адрес
   * доставки разрешено менять. Иначе достаточно вписать другой адрес —
   * и выдача пойдёт заново, сколько угодно раз. Здесь мы разделяем два
   * разных вопроса: «куда прислать» и «кто это».
   *
   * Пусто, если подстановка выключена или площадка ничего не сообщила.
   */
  accountEmail String? @map("account_email")
  /** Остальные поля формы: становятся переменными документа. */
  fields Json   @default("{}")

  /** Нужны для разбора злоупотреблений; хранятся ограниченный срок. */
  ip        String? @db.Inet
  userAgent String? @map("user_agent")

  status  TildaRequestStatus @default(processing)
  fileId  String?            @map("file_id") @db.Uuid
  emailId String?            @map("email_id") @db.Uuid
  error   String?

  createdAt DateTime  @default(now()) @map("created_at")
  doneAt    DateTime? @map("done_at")

  integration TildaIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /**
   * Материал, документ по которому запрашивали. Cascade: заявка на удалённый
   * материал не отвечает уже ни на один вопрос, а поля формы в ней —
   * персональные данные участника.
   */
  document    Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /**
   * Выданный файл и отправленное письмо: их могли удалить и без заявки.
   * Поле письма называется sentEmail — `email` здесь уже занято адресом,
   * который человек вписал в форму.
   */
  file        File?            @relation(fields: [fileId], references: [id], onDelete: SetNull)
  sentEmail   Email?           @relation(fields: [emailId], references: [id], onDelete: SetNull)
  consents    Consent[]

  /**
   * Один выданный документ на пару «документ + адрес». Частичный уникальный
   * индекс только по завершённым заявкам создаётся отдельной миграцией:
   * Prisma частичные индексы в схеме не описывает.
   */
  @@index([integrationId, createdAt])
  @@index([documentId, email])
  @@map("tilda_requests")
}

enum ConsentPurpose {
  certificate
  marketing
  verification
  /** Согласие клиента на публикацию его отзыва с именем и организацией. */
  review_publication
}

enum ReviewStatus {
  pending
  published
  rejected
}

/**
 * Журнал согласий.
 *
 * Доказывать наличие согласия при споре обязан оператор, и «пользователь же
 * нажал галочку» без записи не работает. Договор-поручение отдельно обязывает
 * нас предоставлять эти сведения заказчику по запросу.
 */
model Consent {
  id    String @id @default(uuid()) @db.Uuid
  orgId String @map("org_id") @db.Uuid

  requestId  String? @map("request_id") @db.Uuid
  documentId String? @map("document_id") @db.Uuid

  subjectEmail String         @map("subject_email")
  purpose      ConsentPurpose
  granted      Boolean

  /**
   * Отпечаток текста согласия, который человек видел в момент нажатия.
   * Без него нельзя доказать, на что именно он соглашался: текст меняется.
   */
  textVersion String  @map("text_version")
  formId      String? @map("form_id")

  ip        String? @db.Inet
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  org     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  request TildaRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([orgId, subjectEmail])
  @@index([documentId])
  @@map("consents")
}

/**
 * Отзыв клиента о сервисе.
 *
 * Оставить его может только вошедший пользователь: отзыв от анонимного
 * посетителя ничего не доказывает и открывает форму для спама. Публикуется
 * не сразу — сначала проверка. До публикации требуется отдельное согласие
 * на обнародование имени и организации: без него это персональные данные,
 * которые мы не вправе выкладывать на сайт.
 */
model Review {
  id     String @id @default(uuid()) @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  /** Как подписать отзыв. Заполняется автором, а не берётся из профиля. */
  authorName String  @map("author_name")
  authorRole String  @map("author_role")
  orgName    String  @map("org_name")
  text       String
  /** Необязательная оценка от 1 до 5. */
  rating     Int?

  status      ReviewStatus @default(pending)
  /** Почему отклонён — видно автору, чтобы он мог поправить. */
  moderatorNote String?    @map("moderator_note")

  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, publishedAt])
  @@index([orgId])
  @@map("reviews")
}

enum LeadStatus {
  new
  in_progress
  won
  lost
}

/**
 * Заявка на счёт с посадочной страницы.
 *
 * Организация не покупает нажатием кнопки: сначала ей нужны договор, счёт
 * и ответы юристу. Пока эта заявка уходила письмом на общий ящик, она жила
 * ровно до первого завала входящих — а это единственный вход для крупных
 * клиентов, ради которых сервис и делается.
 *
 * Организация к заявке не привязана: её ещё нет в системе, человек только
 * присматривается.
 */
model Lead {
  id String @id @default(uuid()) @db.Uuid

  orgName String  @map("org_name")
  contact String
  email   String
  phone   String?
  /** ИНН покупателя: без него счёт бесполезен для его бухгалтерии. */
  inn     String?
  /** Выбранный тариф — по нему выставляется счёт без переписки. */
  tariff  String?
  /** Сколько документов в год, если тариф не выбран. */
  volume  String?
  comment String?

  /*
   * Поля заявки «Обсудить условия» (ветка 10-B).
   *
   * Заведены здесь, потому что миграции блока делает только эта ветка.
   * До них тип мероприятий и удобное время звонка складывались в comment
   * одним текстом — искать по такому нельзя, а «позвонить утром» надо
   * не читать глазами, а сортировать.
   */
  /** Какие мероприятия проводит: соревнования, конференции, курсы. */
  eventKinds String[] @map("event_kinds")
  /** Когда удобно звонить. */
  callTime   String?  @map("call_time")
  /** Редакция текста согласия, на которую человек нажал. */
  consentTextVersion String? @map("consent_text_version")

  status LeadStatus @default(new)
  /** Что с заявкой сделали: кому передали, о чём договорились. */
  note   String?

  /** Нужны для разбора злоупотреблений; стираются вместе с остальными следами. */
  ip        String? @db.Inet
  userAgent String? @map("user_agent")
  /** Откуда пришёл: адрес страницы, с которой отправлена форма. */
  source    String?

  createdAt DateTime @default(now()) @map("created_at")

  invoices Invoice[]

  @@index([status, createdAt])
  @@map("leads")
}

/**
 * Счёт на оплату.
 *
 * Нумерация сквозная в пределах года и обеспечивается уникальным индексом:
 * два счёта с одним номером — это разбирательство с бухгалтерией клиента,
 * а не мелкая опечатка.
 *
 * Реквизиты продавца в счёт не копируются: они одни на всё и берутся
 * из окружения при отрисовке. Копия покупателя, наоборот, сохраняется —
 * счёт должен остаться таким, каким его получили, даже если клиент
 * потом переименуется.
 */
model Invoice {
  id     String  @id @default(uuid()) @db.Uuid
  leadId String? @map("lead_id") @db.Uuid

  number Int
  year   Int

  buyerName String  @map("buyer_name")
  buyerInn  String  @map("buyer_inn")
  email     String

  tariff      String
  description String
  /** Сумма в копейках: в рублях с плавающей точкой деньги считать нельзя. */
  amountKopecks Int  @map("amount_kopecks")

  paidAt    DateTime? @map("paid_at")
  /** Идентификатор платежа у платёжного сервиса, когда он появится. */
  paymentId String?   @map("payment_id")

  createdAt DateTime @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")

  /**
   * Заявка, по которой выставлен счёт. SetNull: счёт — бухгалтерский
   * документ и обязан пережить удаление заявки, из которой вырос.
   */
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([year, number])
  @@index([email])
  @@index([leadId])
  @@map("invoices")
}

/**
 * Журнал действий.
 *
 * Отвечает на вопрос «кто и когда это сделал» — он возникает в первом же
 * спорном случае: участник уверяет, что грамоту ему не присылали, а
 * федерация не может ни подтвердить, ни опровергнуть. Без журнала
 * единственный источник правды — память сотрудника.
 *
 * Пишем действия, у которых есть последствия снаружи: выпуск и рассылка
 * документов, отзыв проверки, удаление, изменения в составе сотрудников.
 * Открытие страниц и правку макета не пишем — это шум, в котором тонет
 * то немногое, ради чего журнал заведён.
 *
 * Имя и адрес автора храним копией на момент события: сотрудник может
 * уволиться и быть удалён, а запись обязана остаться читаемой.
 */
model AuditEvent {
  id     BigInt @id @default(autoincrement())
  orgId  String @map("org_id") @db.Uuid

  /** Кто. null — действие системы, например ночная очистка по срокам. */
  userId     String? @map("user_id") @db.Uuid
  actorName  String  @default("") @map("actor_name")
  actorEmail String  @default("") @map("actor_email")

  /** Что: documents.purge, generation.start, mail.send и т.п. */
  action String
  /** Над чем: тип и идентификатор, чтобы можно было найти предмет спора. */
  targetType String? @map("target_type")
  targetId   String? @map("target_id")
  /** Человекочитаемое описание — его и показываем в кабинете. */
  summary String @default("")

  /** Подробности события. Персональных данных сюда не кладём. */
  meta Json @default("{}")

  ip        String?  @db.Inet
  createdAt DateTime @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_events")
}

/**
 * Токен для доступа к API без входа человеком: чужая система, скрипт
 * федерации, помощник на основе ИИ.
 *
 * Храним хеш, а не сам токен. Токен показывается один раз при выдаче
 * и больше нигде: список токенов в кабинете — первое, что прочтёт тот,
 * кто получил доступ к чужой открытой вкладке, и там не должно быть
 * ничего, чем можно воспользоваться.
 */
model ApiToken {
  id    String @id @default(uuid()) @db.Uuid
  orgId String @map("org_id") @db.Uuid

  /** Понятное человеку название: «выгрузка из СпортОрг», «бот федерации». */
  name String

  /// sha256 от токена. Не argon2: токен — это 32 случайных байта, перебирать
  /// его нечем, а проверка идёт на каждом запросе и обязана быть дешёвой.
  tokenHash String @unique @map("token_hash")
  /// Начало токена — чтобы владелец узнал свой среди нескольких.
  prefix String

  /// Права те же, что у сотрудника: обычный работает с материалами,
  /// полный вдобавок удаляет. Управлять людьми токен не может никогда —
  /// иначе он превращался бы в способ завести себе человеческий доступ.
  role OrgRole @default(member)

  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  /// Когда пользовались в последний раз — чтобы видеть забытые токены.
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("api_tokens")
}

// ─── Правила награждения (Фаза 9) ──────────────────────────────────────────

/**
 * Набор правил награждения: «первое место — диплом победителя, снятым
 * ничего, остальным грамота участника».
 *
 * Принадлежит организации, а не документу. Федерация настраивает
 * награждение один раз на сезон, а соревнований за сезон десятки:
 * если бы правила жили у документа, «переиспользовать на следующем
 * соревновании» означало бы собрать их заново.
 */
model AwardRuleSet {
  id    String @id @default(uuid()) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  name  String

  /**
   * Колонка таблицы получателей, по которой строки делятся на группы.
   * Пусто — весь протокол одна группа.
   *
   * Группа задаёт область дедупликации получателя, подпись строки в отчёте
   * и — только для условий с признаком `withinGroup` — круг строк, среди
   * которых пересчитывается место. Сама по себе она место не пересчитывает:
   * в обычном протоколе места уже расставлены по группам, и пересчёт там
   * не нужен, а местами навредил бы (см. комментарий к withinGroup
   * в @gramota/shared).
   */
  groupColumn  String @default("") @map("group_column")
  /** Колонка со статусом (DSQ/DNS/«снят»). Пусто — статусов в протоколе нет. */
  statusColumn String @default("") @map("status_column")

  /**
   * Версия формата правил. Условия и выходы — такой же общий контракт,
   * как макет листа: их читает конструктор в браузере, движок на сервере
   * и превью раскладки. Меняется формат — меняется версия, иначе набор,
   * собранный в прошлом сезоне, однажды применится не так, как задумывали.
   */
  schemaVersion Int @default(1) @map("schema_version")

  /** Предлагать по умолчанию для нового соревнования. */
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rules     AwardRule[]
  documents Document[]   @relation("DocumentRuleSet")

  @@index([orgId, deletedAt])
  @@map("award_rule_sets")
}

/** issue — выдать перечисленные документы; skip — не выдавать ничего. */
enum AwardRuleAction {
  issue
  skip
}

/** Как соединять условия правила. */
enum AwardConditionMatch {
  all
  any
}

/**
 * Одно правило набора.
 *
 * Выигрывает первое совпавшее правило, поэтому порядок задаётся явно
 * через position, а не временем создания: «2–3 место» обязано проверяться
 * раньше, чем «все остальные», иначе призёр получит грамоту участника.
 */
model AwardRule {
  id        String @id @default(uuid()) @db.Uuid
  ruleSetId String @map("rule_set_id") @db.Uuid
  position  Int

  enabled Boolean @default(true)
  /** То, что человек видит в превью: «Победители», «Призёры». */
  label   String  @default("")

  /**
   * Плоский список условий вида {field, op, value}. Валидируется Zod-схемой
   * awardCondition из @gramota/shared.
   *
   * Отдельной таблицы условий нет по той же причине, что у Sheet.layout:
   * SQL-запросов по условиям не бывает, а конструктор сохраняет набор целиком
   * одним PATCH. Пустой список — правило «иначе».
   */
  conditions Json                @default("[]")
  match      AwardConditionMatch @default(all)

  action AwardRuleAction @default(issue)

  /**
   * Что выдаём: список выходов {templateDocumentId, subjectColumn,
   * dedupeScope, label}, схема awardOutput из @gramota/shared.
   *
   * Список, а не один шаблон: за первое место участнику полагается диплом,
   * а его тренеру — благодарность, и это одно решение судейской коллегии.
   * Разнести их по двум правилам нельзя: выигрывает первое совпавшее.
   *
   * Внешнего ключа на documents здесь нет — принадлежность шаблона
   * организации проверяет сервис при сохранении. Ключ этого всё равно
   * не гарантирует: он ручается за существование строки, а не за её
   * владельца. Недоступный шаблон движок отдаёт замечанием «шаблон удалён»,
   * что человеку понятнее внезапно опустевшего поля.
   */
  outputs Json @default("[]")

  ruleSet AwardRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@unique([ruleSetId, position])
  @@map("award_rules")
}

/**
 * Счётчик регистрационных номеров организации за год.
 *
 * Отдельная таблица, а не `MAX(reg_number) + 1`: воркеры выпускают
 * документы параллельно, и два из них взяли бы один номер. Атомарный
 * `INSERT … ON CONFLICT DO UPDATE … RETURNING` выдаёт номера без гонок.
 * Год в ключе — это «сбрасывать 1 января» без отдельной настройки.
 */
model IssueCounter {
  orgId String @map("org_id") @db.Uuid
  year  Int
  value Int    @default(0)

  @@id([orgId, year])
  @@map("issue_counters")
}

// ─── Обратная связь: обращения в поддержку и дорожная карта ─────────────

enum SupportTicketStatus {
  open
  answered
  closed
}

model SupportTicket {
  id      String @id @default(uuid()) @db.Uuid
  orgId   String @map("org_id") @db.Uuid
  /// Кто написал. SetNull: обращение переживает уход сотрудника.
  userId  String? @map("user_id") @db.Uuid
  subject String
  status  SupportTicketStatus @default(open)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([orgId, updatedAt])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model SupportMessage {
  id       String @id @default(uuid()) @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid
  /// Пусто — ответ поддержки, а не сотрудника организации.
  userId   String? @map("user_id") @db.Uuid
  fromSupport Boolean @default(false) @map("from_support")
  text     String
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

enum RoadmapStatus {
  planned
  in_progress
  done
}

/// Что мы собираемся делать. Заводит владелец сервиса; клиенты голосуют.
model RoadmapItem {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  description String        @default("")
  status      RoadmapStatus @default(planned)
  createdAt   DateTime      @default(now()) @map("created_at")

  votes RoadmapVote[]

  @@index([status, createdAt])
  @@map("roadmap_items")
}

/// Голос — один на организацию, а не на человека: иначе голосовали бы приглашениями.
model RoadmapVote {
  itemId    String   @map("item_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  item RoadmapItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([itemId, orgId])
  @@index([orgId])
  @@map("roadmap_votes")
}
