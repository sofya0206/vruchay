# Данные предпринимателя для юридических страниц. Подставляются при сборке.
# В репозиторий заполненная версия не попадает: адрес регистрации ИП —
# это домашний адрес человека. На опубликованной политике он будет —
# этого требует закон, — но в истории изменений ему делать нечего.
#
# Локально: скопировать в apps/web/.env и заполнить.
# В сборке образа: передать как build-args (см. .github/workflows/ci.yml).
VITE_OPERATOR_NAME=Рязанцева Наталья Сергеевна
VITE_OPERATOR_INN=000000000000
VITE_OPERATOR_OGRNIP=000000000000000
VITE_OPERATOR_ADDRESS=Российская Федерация, ...
VITE_OPERATOR_EMAIL=info@vruchay.ru
VITE_OPERATOR_PHONE=+7 ...
# Меняется вместе с текстом политики.
VITE_POLICY_DATE=2 августа 2026 года
