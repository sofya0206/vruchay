# Боевое окружение. Копируется на сервер как /opt/vruchay/.env
#
# Файл содержит все секреты сервиса. Права: chmod 600, владелец — тот
# пользователь, от которого запускается docker compose. В репозиторий
# заполненная версия не попадает никогда: .env в .gitignore.

# ─── Образы ──────────────────────────────────────────────────────────────
# Владелец пакетов в GHCR: ghcr.io/<логин или организация на GitHub>
IMAGE_PREFIX=ghcr.io/CHANGE_ME
# Конкретный образ, а не latest: так откат — это возврат прежнего значения.
IMAGE_TAG=CHANGE_ME_sha_из_CI
# Метка версии, которую отдаёт /health: по ней видно, что выкатилось.
# Пусто — «dev».
APP_VERSION=

# ─── Домен ───────────────────────────────────────────────────────────────
DOMAIN=vruchay.ru
PUBLIC_URL=https://vruchay.ru
NODE_ENV=production
PORT=3000

# ─── База ────────────────────────────────────────────────────────────────
# Пароль: openssl rand -base64 32 | tr -d '/+='
POSTGRES_USER=vruchay
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vruchay
# Хост postgres — имя службы в compose, наружу порт не публикуется.
DATABASE_URL=postgresql://vruchay:CHANGE_ME@postgres:5432/vruchay

REDIS_URL=redis://redis:6379

# ─── Секрет сессий ───────────────────────────────────────────────────────
# openssl rand -base64 48
# Смена значения разлогинивает всех — это нормально, но не делайте её
# посреди рабочего дня без причины.
SESSION_SECRET=CHANGE_ME

# ─── Объектное хранилище (Selectel S3) ───────────────────────────────────
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET=vruchay-prod
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Тот же адрес попадает в политику содержимого страницы: без него
# не отобразятся фоны сертификатов.
S3_ORIGIN=https://s3.ru-1.storage.selcloud.ru

# ─── Присмотр за собой ───────────────────────────────────────────────────
# Куда писать, когда сломалось у нас: не снялась резервная копия, отвалилось
# хранилище. Адрес того, кто пойдёт чинить, а не поддержки для клиентов.
# Пусто — тревоги останутся в журнале сервера, который никто не открывает.
ALERT_EMAIL=CHANGE_ME
# Бакет с копиями базы — тот же, что в /etc/vruchay-backup.env. Приложение
# в него не пишет: раз в сутки в 09:00 смотрит, лежит ли там свежий файл
# нужного размера. Это единственная проверка, которая ловит случай
# «ночное задание вообще не запускалось» — с ним мы уже сталкивались.
BACKUP_S3_BUCKET=s3://vruchay-backups

# ─── Почта ───────────────────────────────────────────────────────────────
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.dashamail.ru
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# Что клиенты пропишут в своей записи SPF, чтобы наши письма проходили проверку.
# Значение должно совпадать с тем, что реально указывает почтовый провайдер.
SMTP_SPF_INCLUDE=CHANGE_ME

# ─── Браузер для печати ──────────────────────────────────────────────────
# Пусто: берётся Chromium, встроенный в образ.
PLAYWRIGHT_CHANNEL=
# RENDER_BASE_URL здесь не нужен: воркеру он задаётся в docker-compose.prod.yml
# как http://web:8080 — страница печати берётся у соседнего контейнера,
# а не через внешний адрес сервера.

# ─── Очередь генерации ───────────────────────────────────────────────────
# Сколько пакетов одна организация держит в очереди одновременно. Воркер
# и так берёт части по одной; ограничение защищает очередь от организации,
# поставившей двадцать пакетов разом, — остальные ждали бы за ней.
# Строка закомментирована — работает умолчание 3. Именно закомментирована,
# а не пуста: умолчание подставляется, только когда ключа нет вовсе,
# а пустая строка проходит как число 0 и валит проверку при старте воркера.
#ORG_ACTIVE_JOBS=3
# Пределы на «Одним PDF на печать»: число документов и суммарный объём в МБ.
# Склейка не стримится — pdf-lib держит в памяти и исходники, и результат.
# У контейнера web mem_limit 1g на всех пользователей сразу, поэтому предел
# жёсткий: за ним кнопка в кабинете гаснет и объясняет причину.
# Закомментированы — работают умолчания 300 документов и 150 МБ.
#PRINT_MERGE_LIMIT_FILES=300
#PRINT_MERGE_LIMIT_MB=150

# ─── Приём платежей (ЮKassa) ─────────────────────────────────────────────
# Пока пусто — приём платежей выключен, остальной сервис работает как обычно.
# Ключи берутся в кабинете ЮKassa для магазина, привязанного к vruchay.ru.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Адрес для уведомлений задаётся в кабинете ЮKassa:
#   https://vruchay.ru/api/v1/payments/yookassa
# События: payment.succeeded, payment.canceled

# ─── Реквизиты продавца для счетов ───────────────────────────────────────
# В репозиторий они не попадают: docs/business/requisites.md в .gitignore.
SELLER_NAME=
SELLER_INN=
SELLER_OGRNIP=
SELLER_ADDRESS=
SELLER_ACCOUNT=
SELLER_BANK=
SELLER_BIK=
SELLER_CORR_ACCOUNT=

# ─── Доверие обратному прокси ────────────────────────────────────────────
# Настоящий адрес посетителя берётся из X-Forwarded-For, который ставит
# Caddy. Без этого все посетители выглядят одним адресом из сети Docker:
# ограничение частоты входа считается общим на всех, защита публичных форм
# от перебора не работает, а в журналах заявок вместо адреса заявителя
# оказывается наш же контейнер.
#
# Доверяем только частным диапазонам — заголовок подделывается тривиально.
# Пустая строка выключает доверие совсем (если API окажется открыт напрямую).
TRUST_PROXY=loopback, linklocal, uniquelocal

# ─── Бесплатная проба и приглашения ──────────────────────────────────────
# Сколько документов даётся бесплатно. Это же число обещано на посадочной —
# меняя здесь, поменяйте и там.
FREE_DOCUMENT_LIMIT=50
# Приглашение друга: награда документами, а не деньгами, и двусторонняя.
# Приглашённый получает свои сразу, пригласивший — когда друг выпустит
# первые REFERRAL_QUALIFY_DOCUMENTS документов (защита от пустых регистраций).
REFERRAL_WELCOME_BONUS=50
REFERRAL_REWARD=50
REFERRAL_QUALIFY_DOCUMENTS=10
REFERRAL_MAX_REWARDED=20

# ─── Организация-площадка ────────────────────────────────────────────────
# Наша собственная организация. По ней кабинет решает, показывать ли
# разделы, за которыми клиента ждёт отказ: счета, заявки, проверка отзывов.
# Пустое значение закрывает эти разделы всем — так и задумано.
PLATFORM_ORG_ID=

# ─── Приём уведомлений от почтового провайдера ───────────────────────────
# Секрет стоит прямо в адресе вебхука. Пустое значение = приём выключен,
# адрес отвечает «не найдено»: ручка меняет состояния писем, и открывать
# её до настройки нельзя. Генерируется: openssl rand -hex 32
# Адреса для кабинета DashaMail — docs/business/настройка-вебхуков-dashamail.md
MAIL_WEBHOOK_SECRET=

# ─── Служебная почта ─────────────────────────────────────────────────────
# Обратный адрес писем самого сервиса: подтверждение регистрации,
# восстановление пароля, приглашения сотрудникам.
SERVICE_MAIL_FROM=Вручай <noreply@vruchay.ru>
# Отдельный отправитель для писем участникам от организаций без своего домена.
# Нужен, чтобы упёршийся предел на рассылку документов не бил по письмам
# восстановления доступа. Строка закомментирована — берётся SERVICE_MAIL_FROM.
# Именно закомментирована, а не пуста: код подставляет запасное значение
# только при отсутствии ключа, а пустая строка означает «отправитель
# не настроен» — рассылка документов молча встанет с ошибкой в журнале.
#PLATFORM_MAIL_FROM=Вручай <noreply@vruchay.ru>
# Ключ транзакционного API DashaMail. Пусто — отправка идёт по SMTP.
DASHAMAIL_API_KEY=

# Сколько писем организация без своего домена отправляет с нашего: за сутки
# и за один запуск рассылки. Репутация общего домена одна на всех, поэтому
# объём с него ограничен; со своего домена ограничения нет.
# Закомментированы — работают умолчания: 500 за сутки и 300 за раз.
# Именно закомментированы, а не пусты: пустая строка проходит как число 0
# и валит проверку при старте.
#SHARED_DOMAIN_DAILY_LIMIT=500
#SHARED_DOMAIN_BATCH_LIMIT=300

# ─── Внутренний адрес страницы печати ────────────────────────────────────
# По нему браузер воркера открывает страницу отрисовки документа.
# Внутри compose это адрес службы web, снаружи — публичный адрес.
RENDER_BASE_URL=http://web
