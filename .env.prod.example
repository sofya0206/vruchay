# Боевое окружение. Копируется на сервер как /opt/vruchay/.env
#
# Файл содержит все секреты сервиса. Права: chmod 600, владелец — тот
# пользователь, от которого запускается docker compose. В репозиторий
# заполненная версия не попадает никогда: .env в .gitignore.

# ─── Образы ──────────────────────────────────────────────────────────────
# Владелец пакетов в GHCR: ghcr.io/<логин или организация на GitHub>
IMAGE_PREFIX=ghcr.io/CHANGE_ME
# Конкретный образ, а не latest: так откат — это возврат прежнего значения.
IMAGE_TAG=CHANGE_ME_sha_из_CI

# ─── Домен ───────────────────────────────────────────────────────────────
DOMAIN=vruchay.ru
PUBLIC_URL=https://vruchay.ru
NODE_ENV=production
PORT=3000

# ─── База ────────────────────────────────────────────────────────────────
# Пароль: openssl rand -base64 32 | tr -d '/+='
POSTGRES_USER=vruchay
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vruchay
# Хост postgres — имя службы в compose, наружу порт не публикуется.
DATABASE_URL=postgresql://vruchay:CHANGE_ME@postgres:5432/vruchay

REDIS_URL=redis://redis:6379

# ─── Секрет сессий ───────────────────────────────────────────────────────
# openssl rand -base64 48
# Смена значения разлогинивает всех — это нормально, но не делайте её
# посреди рабочего дня без причины.
SESSION_SECRET=CHANGE_ME

# ─── Объектное хранилище (Selectel S3) ───────────────────────────────────
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET=vruchay-prod
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Тот же адрес попадает в политику содержимого страницы: без него
# не отобразятся фоны сертификатов.
S3_ORIGIN=https://s3.ru-1.storage.selcloud.ru

# ─── Почта ───────────────────────────────────────────────────────────────
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.dashamail.ru
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# Что клиенты пропишут в своей записи SPF, чтобы наши письма проходили проверку.
# Значение должно совпадать с тем, что реально указывает почтовый провайдер.
SMTP_SPF_INCLUDE=CHANGE_ME

# ─── Браузер для печати ──────────────────────────────────────────────────
# Пусто: берётся Chromium, встроенный в образ.
PLAYWRIGHT_CHANNEL=
# RENDER_BASE_URL здесь не нужен: воркеру он задаётся в docker-compose.prod.yml
# как http://web:8080 — страница печати берётся у соседнего контейнера,
# а не через внешний адрес сервера.

# ─── Приём платежей (ЮKassa) ─────────────────────────────────────────────
# Пока пусто — приём платежей выключен, остальной сервис работает как обычно.
# Ключи берутся в кабинете ЮKassa для магазина, привязанного к vruchay.ru.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Адрес для уведомлений задаётся в кабинете ЮKassa:
#   https://vruchay.ru/api/v1/payments/yookassa
# События: payment.succeeded, payment.canceled

# ─── Реквизиты продавца для счетов ───────────────────────────────────────
# В репозиторий они не попадают: docs/business/requisites.md в .gitignore.
SELLER_NAME=
SELLER_INN=
SELLER_OGRNIP=
SELLER_ADDRESS=
SELLER_ACCOUNT=
SELLER_BANK=
SELLER_BIK=
SELLER_CORR_ACCOUNT=
