# Скопируйте в apps/server/.env для локальной разработки
DATABASE_URL=postgresql://gramota:gramota@localhost:5432/gramota
REDIS_URL=redis://localhost:6379
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_минимум_32_символа_случайной_строки
# Секрет хвоста публичного кода документа (K7M2-9QXR-4TVB). Задать один раз
# и никогда не менять: коды напечатаны на бумаге. Пусто — выводится из
# SESSION_SECRET, и тогда его смена сделает все коды «похожими на опечатку».
# Сгенерировать: openssl rand -base64 32
PUBLIC_CODE_SECRET=
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=gramota
S3_SECRET_KEY=gramota-secret
S3_BUCKET=gramota
SMTP_HOST=localhost
SMTP_PORT=1025
PORT=3000
# Origin объектного хранилища для политики содержимого (CSP)
S3_ORIGIN=https://s3.ru-1.storage.selcloud.ru

# Прод: PostgreSQL в контейнере (см. docker-compose.prod.yml)
POSTGRES_USER=vruchay
POSTGRES_PASSWORD=CHANGE_ME_длинный_случайный_пароль
POSTGRES_DB=vruchay

# Очередь генерации. Строки закомментированы — работают значения по умолчанию:
# 3 пакета на организацию, 300 документов и 150 МБ на «Одним PDF на печать».
# Именно закомментированы, а не пусты: умолчание подставляется, только когда
# ключа нет вовсе, а пустая строка проходит как число 0 и валит проверку
# при старте. Чтобы поменять предел — раскомментируйте и поставьте число.
#ORG_ACTIVE_JOBS=3
#PRINT_MERGE_LIMIT_FILES=300
#PRINT_MERGE_LIMIT_MB=150

# Пределы отправки с общего домена — по той же причине закомментированы.
# Умолчания: 500 писем за сутки и 300 за один запуск рассылки.
#SHARED_DOMAIN_DAILY_LIMIT=500
#SHARED_DOMAIN_BATCH_LIMIT=300
