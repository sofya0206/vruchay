# Скопируйте в apps/server/.env для локальной разработки
DATABASE_URL=postgresql://gramota:gramota@localhost:5432/gramota
REDIS_URL=redis://localhost:6379
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_минимум_32_символа_случайной_строки
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=gramota
S3_SECRET_KEY=gramota-secret
S3_BUCKET=gramota
SMTP_HOST=localhost
SMTP_PORT=1025
PORT=3000
# Origin объектного хранилища для политики содержимого (CSP)
S3_ORIGIN=https://s3.ru-1.storage.selcloud.ru

# Прод: PostgreSQL в контейнере (см. docker-compose.prod.yml)
POSTGRES_USER=vruchay
POSTGRES_PASSWORD=CHANGE_ME_длинный_случайный_пароль
POSTGRES_DB=vruchay

# Очередь генерации. Пусто — значения по умолчанию: 3 пакета на организацию,
# 300 документов и 150 МБ на «Одним PDF на печать».
# Пустое значение везде читается как «не задано»: подставляется значение
# по умолчанию из apps/server/src/config/env.ts, где они все и живут.
ORG_ACTIVE_JOBS=
PRINT_MERGE_LIMIT_FILES=
PRINT_MERGE_LIMIT_MB=

# Пределы отправки с общего домена. Пусто — 500 писем за сутки и 300 за раз.
SHARED_DOMAIN_DAILY_LIMIT=
SHARED_DOMAIN_BATCH_LIMIT=
